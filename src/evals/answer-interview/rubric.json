{
  "schema_version": 1,
  "skill": "answer-interview",
  "checks": [
    {
      "id": "answer-within-requested-limit",
      "description": "Every answer meets its requested minimum and maximum bounds.",
      "handler": "check_answer_within_limit",
      "mandatory": true,
      "required_inputs": [
        "/evidence",
        "/constraints"
      ]
    },
    {
      "id": "reported-count-matches-answer",
      "description": "Every applicable unit has a reported count matching its final answer.",
      "handler": "check_reported_count",
      "mandatory": true,
      "required_inputs": [
        "/evidence",
        "/constraints"
      ]
    },
    {
      "id": "application-job-description-archive",
      "description": "The actual archived posting equals source and supplied output at the numbered path.",
      "handler": "check_job_description_archive",
      "mandatory": true,
      "required_inputs": [
        "/evidence/job_description_archive"
      ]
    }
  ]
}
