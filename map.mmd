---
config:
  look: classic
  layout: elk
  elk:
    considerModelOrder: NONE
    forceNodeModelOrder: false
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
  flowchart:
    curve: linear
---
%%{init: {"theme": "base", "themeVariables": {"background": "transparent", "clusterBkg": "#EFF4FA", "clusterBorder": "#CBD5E1", "edgeLabelBackground": "transparent", "primaryTextColor": "#002B3D", "lineColor": "#002B3D", "fontFamily": "Fira Code, monospace"}}}%%
%% Agent is the sole entry point. Green rounded rectangles: skills.
%% Skill Issue is a decision diamond. Spawn Evals has a coral end node and muted red validation connections without arrowheads.
%% Yellow rounded rectangles: disciplines. Incoming guideline arrows are dashed; internal guideline connections are plain solid lines.
%% Think Harder and Ask User Question run by default and have no relationship lines.
%% Skills that invoke Spawn Evals for validation show a solid line to that discipline.
%% Gray cylinders: knowledge stores. Gray rounded documents: individual files.
%% Subgraphs group resources. Connections show organization or source references.
%% Flow determines columns; prefer short, direct routes with few crossings and bends.
flowchart LR
    skill_issue{"Skill Issue"}
    stack(["AGENT"])
    stack --> skill_issue

    subgraph admin_skills [Admin Skills]
        create_skill("Create Skill")
        create_guidelines("Create Guidelines")
    end

    subgraph writing_skills [Writing Skills]
        natural_writing("Natural Writing")
        translate("Translate")

    end

    subgraph academic_skills [Academic Skills]
        research("Research")
    end

    subgraph product_skills [Product & Business Skills]
		market_research("Market Research")
        business_plan("Business Plan")
        investor_deck("Investor Deck")
    end

	subgraph design_skills [Design Skills]
        audit_accessibility("Audit Accessibility")
        brand_discovery("Brand Discovery")
        audit_ux("Audit UX")
        design_shotgun("Design Shotgun")
        design_system("Design System")
        brainstorm("Brainstorm")

    end

    subgraph engineering_skills [Engineering Skills]
        prototype("Prototype")
        ship("Ship")

    end

	subgraph data_skills [Data Skills]
        steal("Steal")
    end

    subgraph marketing_skills [Marketing Skills]
        create_image_ads("Create Image Ads")
        polish_video("Polish Short Video")
        product_video("Product Video")
        launch_ads("Launch Ads")
        analyse_ads("Analyse Ads Performance")

    end

    skill_issue -.- admin_skills
    skill_issue -.- writing_skills
    skill_issue -.- academic_skills
    skill_issue -.- marketing_skills
    skill_issue -.- product_skills
    skill_issue -.- design_skills
    skill_issue -.- engineering_skills
    skill_issue -.- data_skills
    subgraph discipline_map [Disciplines]
        spawn_evals(["Spawn Evals"])
        ask_user_question("Ask User Question")
        think_harder("Think Harder")
        browse_skills("Browse Skills")
        update_changelog("Update Changelog")
        quit_the_yap("Quit the Yap")
        update_map("Update Map")
        update_router("Update Router")
        research_web("Research Web")
        research_literature("Research Literature")
        scrape_web("Scrape Web")
        manage_ads("Manage Ads")
        image_tools("Image Tools")
        video_tools("Video Tools")
        creativity("Creativity")
    end

    research --> research_literature
    steal --> scrape_web
    market_research --> research_web
    launch_ads --> manage_ads
    analyse_ads --> manage_ads
    product_video --> video_tools
    polish_video --> video_tools
    create_image_ads --> image_tools
    brainstorm --> creativity

    subgraph template_files [Templates]
        templates[("Templates")]
        templates --- template_skill("SKILL")
        templates --- template_ref("Reference")
        templates --- router_ref("Router")
        templates --- agents_template("AGENTS")
    end

    subgraph language_guides [Language Guidelines]
        english[("English")]
        german[("German")]
        dutch[("Dutch")]
        french[("French")]
    end

    subgraph product_biz_guides [Product & Business Guidelines]
        product_pitch[("Product Pitch")]
    end

    subgraph design_guides [Design Guidelines]
        aesthetics[("Aesthetics")]
        design_system_guide[("Design System")]
        wireframes[("Wireframes")]
        aesthetics --- interface("Interface")
        aesthetics --- typography("Typography")
        aesthetics --- accessibility("Accessibility")
    end

    subgraph tech_guides [Technical Guidelines]
        docs[("Documentation")]
        changelog[("Changelog")]
        git[("Git")]
        versioning[("Versioning")]
        tech_spec[("Technical Specifications")]
        ts[("TypeScript")]
        mermaid[("Mermaid")]
    end

    create_skill --> templates
    create_skill --> natural_writing
    create_skill --> research_web
    create_skill --> browse_skills
    create_skill --> update_map
    create_skill --> update_router
    update_router --> templates
    create_guidelines --> templates
    create_guidelines --> research_web
    create_guidelines --> browse_skills
    create_guidelines --> update_map
    update_map -.-> mermaid
    update_changelog -.-> changelog
    update_changelog -.-> versioning
    update_changelog -.-> git
    quit_the_yap -.-> english
    translate --> natural_writing
    translate eval_translate@--- spawn_evals
    natural_writing eval_natural_writing@--- spawn_evals
    natural_writing -.-> english
    natural_writing -.-> dutch
    natural_writing -.-> french
    natural_writing -.-> german
    design_shotgun -.-> wireframes
    design_shotgun -.-> aesthetics
    design_system -.-> design_system_guide
    design_system -.-> aesthetics
    audit_ux -.-> aesthetics
    audit_accessibility -.-> aesthetics
    brand_discovery --> brainstorm
    brand_discovery --> research_web
    ship -.-> git
    ship -.-> changelog
    ship -.-> docs
    prototype -.-> tech_spec

    classDef entry fill:#DFF7A5,stroke:#002B3D,color:#002B3D,stroke-width:2px
    classDef skill fill:#DFF7A5,stroke:#002B3D,color:#002B3D,stroke-width:1.5px
    classDef method fill:#FFE99A,stroke:#002B3D,color:#002B3D,stroke-width:1.5px
    classDef decision fill:#C9CEF4,stroke:#002B3D,color:#002B3D,stroke-width:1.5px
    classDef evaluation_link stroke:#C96B6B,stroke-width:2px,color:#C96B6B
    classDef evaluation fill:#F5C9C5,stroke:#002B3D,color:#002B3D,stroke-width:2px
    classDef knowledge fill:#EFF4FA,stroke:#002B3D,color:#002B3D,stroke-width:1.5px
    classDef document fill:#EFF4FA,stroke:#002B3D,color:#002B3D,stroke-width:1.5px
    classDef section rx:8px,ry:8px
    class ask_user_question,think_harder,browse_skills,update_changelog,quit_the_yap,update_map,update_router,research_web,scrape_web,research_literature,manage_ads,creativity,image_tools,video_tools method;
    class skill_issue decision
    class eval_create_skill,eval_translate,eval_natural_writing evaluation_link
    class spawn_evals evaluation
    class stack entry
    class natural_writing,create_guidelines,research,translate,analyse_ads,audit_accessibility,audit_ux,brainstorm,brand_discovery,business_plan,create_image_ads,create_skill,design_shotgun,design_system,investor_deck,launch_ads,market_research,polish_video,product_video,prototype,ship,steal skill
    class aesthetics,changelog,design_system_guide,docs,dutch,english,french,german,git,versioning,mermaid,product_pitch,tech_spec,templates,ts,wireframes knowledge;
    class interface,typography,accessibility,template_skill,template_ref,router_ref,agents_template document;
    class design_guides,product_biz_guides,tech_guides,template_files,admin_skills,language_guides,academic_skills,data_skills,design_skills,marketing_skills,product_skills,writing_skills,video_skills,engineering_skills,discipline_map,guide_map section
    linkStyle default stroke-width:1.5px,color:#002B3D
